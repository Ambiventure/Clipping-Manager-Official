{
  "_comment": "Per-division caption profiles. Edit freely; the app reloads these at startup, no recompile needed. caption_position: before | after | burned.",
  "_version": 1,
  "sections": {
    "_comment": "Canonical section names and the aliases seen in the real documents. Matched case-insensitively with fuzzy tolerance for typos.",
    "order": [
      "Positive",
      "Neutral",
      "Digital",
      "Advertisement",
      "Negative",
      "Electronic",
      "Social"
    ],
    "aliases": {
      "Positive": [
        "positive news",
        "positive"
      ],
      "Neutral": [
        "neutral news",
        "nerutral news",
        "netural news",
        "neutral"
      ],
      "Digital": [
        "digital news",
        "digital media",
        "digital"
      ],
      "Advertisement": [
        "advertisement",
        "advertisements",
        "advt"
      ],
      "Negative": [
        "negative news",
        "negative nil",
        "negative news nil",
        "negative"
      ],
      "Electronic": [
        "electronic media"
      ],
      "Social": [
        "social media"
      ]
    },
    "_titled_comment": "Sections whose name the source document prints on the page itself, over the first item of the run. Only these carry that heading into the exported report. The division documents head their runs too (POSITIVE NEWS :-) and have never printed them.",
    "titled": [
      "Electronic",
      "Social"
    ],
    "fuzzy_threshold": 82,
    "default": "Neutral"
  },
  "ignore_caption_patterns": [
    "^\\s*$",
    "^dated?\\b",
    "daily report",
    "analysis of press",
    "^northern rail",
    "^\\s*\\w+\\s+division\\s*$",
    "division\\s+date",
    "media coverage"
  ],
  "divisions": {
    "DLI": {
      "name": "Delhi",
      "filename_aliases": [
        "DLI",
        "DELHI"
      ],
      "caption_position": "burned",
      "needs_ocr": true,
      "caption_regexes": [],
      "split_name": true,
      "full_name": "Delhi Division",
      "hindi_name": "दिल्ली मंडल",
      "colour": "#3B82F6",
      "description": "National Capital Region, Ghaziabad, Meerut, Panipat, Rohtak",
