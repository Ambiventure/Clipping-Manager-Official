  "junk_filter": {
    "_comment": "A clip is only flagged, never deleted. min_dimension applies only when the image is small in BOTH directions, so a wide 688x118 digital-news strip is not mistaken for an icon.",
    "min_dimension_px": 120,
    "small_max_dimension_px": 400,
    "max_aspect_ratio": 8.0,
    "flag_before_first_section": true,
    "flag_uncaptioned_before_first_caption": true
  },
  "name_matching": {
    "_comment": "Scores are 0-100. A newspaper only replaces the caption text with its canonical spelling once it scores at least accept_score; below weak_score the text is kept verbatim and the clip is flagged amber for review.",
    "newspaper_weight": 0.65,
    "edition_weight": 0.35,
    "no_edition_score": 50,
    "accept_score": 85,
    "weak_score": 65,
    "partial_min_alias_len": 6
  },
  "division_order": [
