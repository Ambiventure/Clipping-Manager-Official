        "^(?P<edition>[^-\\u2013\\u2014]+?)\\s*[-\\u2013\\u2014]\\s*(?P<newspaper>[^-\\u2013\\u2014]+?)\\s*[-\\u2013\\u2014]\\s*Page\\s*[-.:]?\\s*(?P<page>\\d+)"
